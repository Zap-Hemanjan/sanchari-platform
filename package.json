{
  "name": "sanchari-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "pretest": "cross-env DATABASE_URL=file:./test.db prisma db push --skip-generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "6.25.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.20",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
