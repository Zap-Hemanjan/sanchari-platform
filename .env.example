# Copy this file to .env and fill in values. Nothing here is required to run
# `npm run dev` locally — with no CLOUDINARY_URL / RESEND_API_KEY set, the app
# automatically falls back to local-disk image storage and console-logged
# password-reset emails (see src/lib/storage and src/lib/email).

# SQLite locally. Swapped to a Neon Postgres connection string at deploy time
# (see README for the "first Postgres deploy" migration step).
DATABASE_URL="file:./dev.db"

# Seed script (prisma/seed.ts) creates exactly one admin account from these.
# Change the password immediately after first login in a real deployment.
ADMIN_EMAIL="admin@sanchari.travel"
ADMIN_INITIAL_PASSWORD="change-me-now"

# Public base URL used to build absolute links (e.g. inside reset-password
# emails). Update to the live Vercel URL after deploying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Production-only: leave unset for local dev ---

# Cloudinary upload URL, e.g. cloudinary://<api_key>:<api_secret>@<cloud_name>
# When unset, uploads are written to public/uploads instead.
# CLOUDINARY_URL=""

# Resend API key. When unset, password-reset links are logged to the server
# console instead of emailed.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Sanchari <no-reply@sanchari.travel>"
